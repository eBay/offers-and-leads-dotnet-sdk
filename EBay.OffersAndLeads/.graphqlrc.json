{
  "schema": "../specs/eBay_Graph.graphqls",
  "documents": "graphql/operations/**/*.graphql",
  "extensions": {
    "strawberryShake": {
      "name": "OffersAndLeadsGraphQLClient",
      "namespace": "EBay.OffersAndLeads.Generated.GraphQL",
      "url": "https://api.ebay.com/graphql",
      "dependencyInjection": true,
      "noStore": true,
      "requestStrategy": "Default",
      "transportProfiles": [{ "default": "Http" }]
    }
  }
}
