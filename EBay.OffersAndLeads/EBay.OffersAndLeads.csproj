<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EBay.OffersAndLeads</RootNamespace>
    <AssemblyName>EBay.OffersAndLeads</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EBay.OffersAndLeads</PackageId>
    <Version>0.3.0</Version>
    <Authors>eBay</Authors>
    <Description>Offers and Leads SDK for eBay Feed API and GraphQL Offer operations</Description>
    <PackageProjectUrl>https://github.com/eBay/offers-and-leads-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/offers-and-leads-dotnet-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <PackageReference Include="StrawberryShake.Server" Version="16.*" />
  </ItemGroup>

</Project>
