set -euo pipefail

cd "$(dirname "$0")/.."

shopt -s nullglob
projects=(EBay.*/EBay.*.csproj)
if [ "${#projects[@]}" -ne 1 ]; then
  echo "expected exactly one EBay.*/EBay.*.csproj, found ${#projects[@]}: ${projects[*]:-<none>}" >&2
  exit 1
fi

project="${projects[0]}"
if [ ! -f "${project%/*}/obj/project.assets.json" ]; then
  dotnet restore "$project"
fi
dotnet build "$project" -p:EBayLint=true --no-incremental
